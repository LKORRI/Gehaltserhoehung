{
  "rules": {
    "games": {
      "$g": {
        ".read": true,
        ".write": "!data.exists()",
        "state": { ".write": true },
        "players": {
          "$pid": {
            ".write": true,
            ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "runs": { "$pid": { "$run": { ".write": "!data.exists()" } } },
        "feed": { "$k": { ".write": "!data.exists()", ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 120" } }
      }
    }
  }
}
